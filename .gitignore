# Spreadsheet source files (personal data)
*.xlsx
*.xls
*.ods
!Magic Deck Spreadsheet v2.xlsx
# Planning notes (local only)
plan.md

# ============================================================
# DDEV
# ============================================================
.ddev/config.local.yaml
.ddev/.gitignore

# Solr runtime data — created by the container (UID 8983), never commit.
drupal/.ddev/solr-core/data/

# Mutagen sync (DDEV performance_mode: mutagen): staging files it writes
# while syncing container changes back, e.g. during composer updates.
.mutagen-temporary-*
.mutagen*.tmp
drupal/.ddev/mutagen/

# ============================================================
# Drupal
# ============================================================
drupal/vendor/
drupal/web/sites/default/files/
drupal/web/sites/default/settings.local.php
drupal/web/sites/default/services.cors.env.yml
drupal/web/sites/simpletest/

# Composer-generated lock artifacts (keep composer.lock in git)
drupal/web/core/
drupal/web/modules/contrib/
drupal/web/themes/contrib/
drupal/web/profiles/contrib/
drupal/web/libraries/

# Scryfall bulk data (~300 MB, re-downloaded by sync module)
drupal/web/modules/custom/mtg_scryfall_sync/data/*.json

# Drupal private files / temp
drupal/private/
drupal/scripts/
drupal/tmp/

# ============================================================
# Next.js / Node
# ============================================================
node_modules/
mtg-app/.next/
# TypeScript incremental build cache, rewritten by every type check.
*.tsbuildinfo
mtg-app/.env
mtg-app/.env.local
mtg-app/.env.development
mtg-app/.env.development.local
mtg-app/.env.production.local
# The user's own decklists, used by local tests only (personal data).
mtg-app/src/utils/__fixtures__/testDecks.json
# Tournament decks with land pools for the land base benchmark (local, 3 MB).
mtg-app/src/utils/__fixtures__/metaBenchmark.json
*.log

# ============================================================
# Environment & secrets
# ============================================================
.env
.env.local
*.env.local

# ============================================================
# Python sim services
# ============================================================
mtg-sim/**/__pycache__/
mtg-sim/**/.venv/
mtg-sim/**/model.joblib
# Python sim runtime caches (deck scripts, etc.)
mtg-sim/data/
mtg-sim/sim/data/deck_scripts/**/*.json
mtg-sim/**/*.pyc
# ============================================================
# OS & editor
# ============================================================
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.swp
*.swo

# Ignore local AI agent skills
skills/
docs/

REVIEW.md
# Local database dumps.
backups/
