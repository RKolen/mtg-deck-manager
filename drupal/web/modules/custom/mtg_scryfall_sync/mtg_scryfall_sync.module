<?php

/**
 * @file
 * MTG Scryfall Sync module file.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\mtg_scryfall_sync\Plugin\EntityReferenceSelection\MtgCardSelection;
use Drupal\node\NodeInterface;

/**
 * Implements hook_field_widget_single_element_form_alter().
 *
 * Entity autocomplete normally shows only the node title for selected values.
 * For MTG card references, show set + price the same way as search matches.
 */
function mtg_scryfall_sync_field_widget_single_element_form_alter(array &$element, FormStateInterface $form_state, array $context): void {
  $widget = $context['widget'] ?? NULL;
  if ($widget === NULL || $widget->getPluginId() !== 'entity_reference_autocomplete') {
    return;
  }

  $items = $context['items'] ?? NULL;
  if ($items === NULL || $items->getFieldDefinition()->getSetting('handler') !== 'mtg_card:node') {
    return;
  }

  // Core wraps the autocomplete in a target_id child.
  if (!isset($element['target_id']) || !is_array($element['target_id'])) {
    return;
  }

  $default = $element['target_id']['#default_value'] ?? NULL;
  if (!$default instanceof NodeInterface || $default->bundle() !== 'mtg_card') {
    return;
  }

  // Keep trailing "(nid)" so EntityAutocomplete can resolve the reference.
  // Disable core's default label processing so our set/price text is kept.
  $element['target_id']['#default_value'] = MtgCardSelection::formatLabel($default) . ' (' . $default->id() . ')';
  $element['target_id']['#process_default_value'] = FALSE;
  // Labels with set + prices are longer than a bare title.
  $element['target_id']['#maxlength'] = 2048;
  $element['target_id']['#size'] = max(80, (int) ($element['target_id']['#size'] ?? 60));
}

/**
 * Implements hook_entity_type_alter().
 *
 * Attaches the DeckCopyLimit validation constraint to the deck node bundle.
 * This enforces per-card copy limits (4-of, or singleton for Commander/EDH
 * and Tiny Leaders/TLR) with exceptions for basic lands and oracle
 * "any number" / "up to N" cards, plus the Tiny Leaders MV <= 3 rule,
 * on every deck save including direct JSON:API writes. Deck and
 * sideboard totals are not hard-blocked.
 *
 * @param array<string, \Drupal\Core\Entity\EntityTypeInterface> $entity_types
 *   The master entity type list, keyed by entity type ID.
 */
function mtg_scryfall_sync_entity_type_alter(array &$entity_types): void {
  if (isset($entity_types['node'])) {
    $entity_types['node']->addConstraint('DeckCopyLimit');
  }
}

/**
 * Implements hook_cron().
 *
 * Triggers a weekly Scryfall sync by queueing a batch import job. The sync
 * only runs if more than 7 days have passed since the last successful sync.
 */
function mtg_scryfall_sync_cron(): void {
  $config = \Drupal::state();
  $last_sync = $config->get('mtg_scryfall_sync.last_sync', 0);
  $interval = 60 * 60 * 24 * 7;

  if (\Drupal::time()->getRequestTime() - $last_sync >= $interval) {
    /** @var \Drupal\mtg_scryfall_sync\ScryfallImporter $importer */
    $importer = \Drupal::service('mtg_scryfall_sync.importer');
    $importer->queueFullSync();
    \Drupal::logger('mtg_scryfall_sync')->info('Weekly Scryfall sync queued by cron.');
  }
}
