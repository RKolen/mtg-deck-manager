<?php

declare(strict_types=1);

/**
 * @file
 * Install, update, and uninstall functions for the MTG Scryfall Sync module.
 */

use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\taxonomy\Entity\Vocabulary;

/**
 * Adds pricing, set metadata, rarity, collector number, and combo piece fields.
 *
 * Run via: ddev drush updb -y
 */
function mtg_scryfall_sync_update_9001(array &$sandbox): string {
  $fields = [
    [
      'name'        => 'field_price_usd',
      'type'        => 'decimal',
      'label'       => 'Price (USD)',
      'cardinality' => 1,
      'settings'    => ['precision' => 10, 'scale' => 2],
    ],
    [
      'name'        => 'field_price_usd_foil',
      'type'        => 'decimal',
      'label'       => 'Price Foil (USD)',
      'cardinality' => 1,
      'settings'    => ['precision' => 10, 'scale' => 2],
    ],
    [
      'name'        => 'field_price_eur',
      'type'        => 'decimal',
      'label'       => 'Price (EUR)',
      'cardinality' => 1,
      'settings'    => ['precision' => 10, 'scale' => 2],
    ],
    [
      'name'        => 'field_set_code',
      'type'        => 'string',
      'label'       => 'Set Code',
      'cardinality' => 1,
      'settings'    => ['max_length' => 16],
    ],
    [
      'name'        => 'field_set_name',
      'type'        => 'string',
      'label'       => 'Set Name',
      'cardinality' => 1,
      'settings'    => ['max_length' => 255],
    ],
    [
      'name'        => 'field_rarity',
      'type'        => 'string',
      'label'       => 'Rarity',
      'cardinality' => 1,
      'settings'    => ['max_length' => 20],
    ],
    [
      'name'        => 'field_collector_number',
      'type'        => 'string',
      'label'       => 'Collector Number',
      'cardinality' => 1,
      'settings'    => ['max_length' => 16],
    ],
    [
      'name'        => 'field_combo_pieces',
      'type'        => 'string',
      'label'       => 'Combo Piece IDs',
      'cardinality' => -1,
      'settings'    => ['max_length' => 36],
    ],
  ];

  $created = [];
  foreach ($fields as $def) {
    if (!FieldStorageConfig::loadByName('node', $def['name'])) {
      FieldStorageConfig::create([
        'field_name'  => $def['name'],
        'entity_type' => 'node',
        'type'        => $def['type'],
        'cardinality' => $def['cardinality'],
        'settings'    => $def['settings'],
      ])->save();
    }

    if (!FieldConfig::loadByName('node', 'mtg_card', $def['name'])) {
      FieldConfig::create([
        'field_name'  => $def['name'],
        'entity_type' => 'node',
        'bundle'      => 'mtg_card',
        'label'       => $def['label'],
        'required'    => FALSE,
      ])->save();
      $created[] = $def['name'];
    }
  }

  return $created !== []
    ? 'Created fields: ' . implode(', ', $created)
    : 'All Phase 9 fields already exist.';
}

/**
 * Adds field_price_eur_foil for Scryfall Cardmarket foil trend prices.
 */
function mtg_scryfall_sync_update_9002(): string {
  $name = 'field_price_eur_foil';
  if (!FieldStorageConfig::loadByName('node', $name)) {
    FieldStorageConfig::create([
      'field_name'  => $name,
      'entity_type' => 'node',
      'type'        => 'decimal',
      'cardinality' => 1,
      'settings'    => ['precision' => 10, 'scale' => 2],
    ])->save();
  }

  if (!FieldConfig::loadByName('node', 'mtg_card', $name)) {
    FieldConfig::create([
      'field_name'  => $name,
      'entity_type' => 'node',
      'bundle'      => 'mtg_card',
      'label'       => 'Price Foil (EUR)',
      'required'    => FALSE,
    ])->save();
    return 'Created field_price_eur_foil.';
  }

  return 'field_price_eur_foil already exists.';
}

/**
 * Adds mtg_set vocabulary, term set-code field, and card field_set reference.
 */
function mtg_scryfall_sync_update_9003(): string {
  $messages = [];

  if (!Vocabulary::load('mtg_set')) {
    Vocabulary::create([
      'vid' => 'mtg_set',
      'name' => 'MTG Set',
      'description' => 'Scryfall print sets. Term name is the set name; field_set_code holds the abbreviation.',
    ])->save();
    $messages[] = 'vocabulary mtg_set';
  }

  if (!FieldStorageConfig::loadByName('taxonomy_term', 'field_set_code')) {
    FieldStorageConfig::create([
      'field_name' => 'field_set_code',
      'entity_type' => 'taxonomy_term',
      'type' => 'string',
      'cardinality' => 1,
      'settings' => ['max_length' => 16],
    ])->save();
    $messages[] = 'term field_set_code storage';
  }

  if (!FieldConfig::loadByName('taxonomy_term', 'mtg_set', 'field_set_code')) {
    FieldConfig::create([
      'field_name' => 'field_set_code',
      'entity_type' => 'taxonomy_term',
      'bundle' => 'mtg_set',
      'label' => 'Set code',
      'required' => TRUE,
      'description' => 'Scryfall set abbreviation (e.g. mh2).',
    ])->save();
    $messages[] = 'term field_set_code';
  }

  if (!FieldStorageConfig::loadByName('node', 'field_set')) {
    FieldStorageConfig::create([
      'field_name' => 'field_set',
      'entity_type' => 'node',
      'type' => 'entity_reference',
      'cardinality' => 1,
      'settings' => ['target_type' => 'taxonomy_term'],
    ])->save();
    $messages[] = 'node field_set storage';
  }

  if (!FieldConfig::loadByName('node', 'mtg_card', 'field_set')) {
    FieldConfig::create([
      'field_name' => 'field_set',
      'entity_type' => 'node',
      'bundle' => 'mtg_card',
      'label' => 'Set',
      'required' => FALSE,
      'description' => 'Print set (taxonomy). Prefer this over typing set codes.',
      'settings' => [
        'handler' => 'default:taxonomy_term',
        'handler_settings' => [
          'target_bundles' => ['mtg_set' => 'mtg_set'],
          'sort' => ['field' => 'name', 'direction' => 'asc'],
          'auto_create' => FALSE,
        ],
      ],
    ])->save();
    $messages[] = 'node field_set';
  }

  /** @var \Drupal\mtg_scryfall_sync\Service\SetTaxonomy $sets */
  $sets = \Drupal::service('mtg_scryfall_sync.set_taxonomy');
  $result = $sets->syncFromCards();
  $sync_note = sprintf('synced %d set terms (%d new)', $result['total'], $result['created']);
  if ($messages === []) {
    return 'mtg_set taxonomy already present; ' . $sync_note . '.';
  }
  $messages[] = $sync_note;
  return 'Created/updated: ' . implode(', ', $messages) . '.';
}

/**
 * Adds Scryfall full_art and border_color fields on mtg_card.
 */
function mtg_scryfall_sync_update_9004(): string {
  $created = [];

  if (!FieldStorageConfig::loadByName('node', 'field_full_art')) {
    FieldStorageConfig::create([
      'field_name' => 'field_full_art',
      'entity_type' => 'node',
      'type' => 'boolean',
      'cardinality' => 1,
    ])->save();
    $created[] = 'field_full_art storage';
  }
  if (!FieldConfig::loadByName('node', 'mtg_card', 'field_full_art')) {
    FieldConfig::create([
      'field_name' => 'field_full_art',
      'entity_type' => 'node',
      'bundle' => 'mtg_card',
      'label' => 'Full art',
      'description' => 'Scryfall full_art flag.',
      'required' => FALSE,
      'default_value' => [['value' => 0]],
      'settings' => [
        'on_label' => 'Full art',
        'off_label' => 'Standard',
      ],
    ])->save();
    $created[] = 'field_full_art';
  }

  if (!FieldStorageConfig::loadByName('node', 'field_border_color')) {
    FieldStorageConfig::create([
      'field_name' => 'field_border_color',
      'entity_type' => 'node',
      'type' => 'string',
      'cardinality' => 1,
      'settings' => ['max_length' => 16],
    ])->save();
    $created[] = 'field_border_color storage';
  }
  if (!FieldConfig::loadByName('node', 'mtg_card', 'field_border_color')) {
    FieldConfig::create([
      'field_name' => 'field_border_color',
      'entity_type' => 'node',
      'bundle' => 'mtg_card',
      'label' => 'Border color',
      'description' => 'Scryfall border_color (black, white, borderless, silver, gold).',
      'required' => FALSE,
    ])->save();
    $created[] = 'field_border_color';
  }

  return $created === []
    ? 'field_full_art and field_border_color already exist.'
    : 'Created: ' . implode(', ', $created) . '.';
}
