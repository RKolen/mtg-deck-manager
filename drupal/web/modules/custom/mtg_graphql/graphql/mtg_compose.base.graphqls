type CardPage {
  cards: [MtgCard!]!
  nextCursor: String
  total: Int!
}

type CardSearchResult {
  cards: [MtgCard!]!
  count: Int!
  pages: Int!
}

type CardSet {
  code: String!
  name: String!
  count: Int!
}

type MtgCard {
  id: ID!
  title: String!
  manaCost: String
  cmc: Float
  typeLine: String
  colors: [String!]!
  colorIdentity: [String!]!
  oracleText: String
  imageUri: String
  imageLocalUri: String
  isManaProducer: Boolean!
  producedMana: [String!]!
  legalFormats: [String!]!
  restrictedFormats: [String!]!
  priceUsd: String
  priceUsdFoil: String
  priceEur: String
  priceEurFoil: String
  setCode: String
  setName: String
  rarity: String
  collectorNumber: String
  power: String
  toughness: String
  loyalty: String
  fullArt: Boolean
  borderColor: String
}

type Deck {
  id: ID!
  nid: Int!
  title: String!
  format: String!
  notes: String
  commander: MtgCard
  commanderIsFoil: Boolean!
}

type DeckCard {
  id: ID!
  quantity: Int!
  isSideboard: Boolean!
  isFoil: Boolean!
  "main, side or maybe."
  board: String!
  card: MtgCard!
}

type DeckCardSlot {
  id: ID!
  quantity: Int!
  isSideboard: Boolean!
  isFoil: Boolean!
  "main, side or maybe."
  board: String!
}

type Page {
  id: ID!
  title: String!
  body: String
  pathAlias: String
}

type CollectionCard {
  id: ID!
  quantityOwned: Int!
  quantityFoil: Int!
  "Copies (regular and foil together) available for trade."
  quantityTrade: Int!
  binderLocation: String
  card: MtgCard
}

"A collection row with the display fields of its card, read in bulk."
type CollectionRow {
  id: ID!
  cardId: ID!
  title: String!
  quantityOwned: Int!
  quantityFoil: Int!
  quantityTrade: Int!
  binderLocation: String
  setCode: String
  setName: String
  collectorNumber: String
  typeLine: String
  cmc: Float
  priceUsd: String
  priceUsdFoil: String
  priceEur: String
  priceEurFoil: String
  imageUri: String
  fullArt: Boolean!
  borderColor: String
}

type MetaDeck {
  id: ID!
  title: String!
  format: String!
  metaShare: Float
  archetypeTags: [String!]!
  fetchedAt: String
  cardsJson: String
  pilotPrompt: String
}

type MtgFormat {
  name: String!
  slug: String!
}

type ScrapeMetaDecksResult {
  format: String!
  created: Int!
  updated: Int!
  skipped: Int!
}

type SimulationResult {
  id: ID!
  nid: Int!
  opponent: String!
  format: String!
  games: Int!
  wins: Int!
  winRate: Float!
  resultJson: String!
  created: String!
  deckTitle: String!
  deckNotes: String
  deckCards: [DeckCard!]!
}

type WishIntent {
  id: ID!
  name: String!
}

type WishlistItem {
  id: ID!
  quantity: Int!
  "Any printing of the card fills the wish; false means this exact printing."
  anyPrinting: Boolean!
  foil: Boolean!
  "Minimum Cardmarket condition: M, NM, EX, GD, LP, PL or PO."
  minCondition: String
  notes: String
  card: MtgCard
  deck: Deck
  intent: WishIntent
  "Copies in the collection that count toward this wish."
  owned: Int!
  "True when the collection already holds the wanted quantity."
  done: Boolean!
  "Price of one copy in EUR: the cheapest priced printing for any-printing wishes."
  priceEur: Float
  "Price of one copy in USD: the cheapest priced printing for any-printing wishes."
  priceUsd: Float
}

type CollectionImportResult {
  "Zero-based index of the input row."
  row: Int!
  "matched (dry run), added, skipped or not_found."
  status: String!
  "scryfall_id, set_number, set_name, name or none."
  matchedBy: String!
  card: MtgCard
}

"A card available for deck building: one printing per card name."
type PoolCard {
  card: MtgCard!
  "Copies owned, all printings and finishes."
  owned: Int!
  "Owned copies set aside for trade."
  trade: Int!
  "Other decks using this card (main deck, sideboard or commander; not maybeboards)."
  usedIn: [CardUse!]!
}

type CardUse {
  deckId: ID!
  deckTitle: String!
  quantity: Int!
}

"Cards whose price changed most since the previous price import."
type PriceMovers {
  "When the previous prices were captured (Unix time), or null before the first import."
  since: Int
  movers: [PriceMover!]!
}

type PriceMover {
  card: MtgCard!
  previous: Float!
  current: Float!
  "Change in percent, e.g. 35.2 or -12.5."
  changePct: Float!
}
